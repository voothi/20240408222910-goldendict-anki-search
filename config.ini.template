[Search]
# Characters that denote a phrase boundary. Anchors will not cross these characters.
separator_chars = . , : ; ? ! —

# Number of words to use for the start/end anchors.
anchor_length = 4

# If true (default), the script verifies that the combined text of the found range
# matches your query. If false, it skips this check—useful if your query 
# text slightly differs from Anki content (e.g. after AI processing).
verify_content = false

# If true (default), replaces punctuation and spaces in anchors with wildcards.
# This makes search more lenient to differences in internal punctuation
# (e.g., matching "Bellugi 1973" against "Bellugi, 1973").
anchor_soft_matching = true

# Optional: Filter search results by a specific deck (or part of the deck name).
# The script will search for decks matching *value*.
# Examples: 
#   deck_filter = 201100                  (matches "Root::201100-MyDeck" etc.)
#   deck_filter = deck:201100             (same as above, explicit prefix)
#   deck_filter = 
#       201100-en-common::...             (multi-line value must be indented)
# Leave empty to search all decks.
deck_filter = 
